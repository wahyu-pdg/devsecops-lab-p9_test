# Menggunakan base image besar dan lama
FROM ubuntu:18.04

# Menginstal package tanpa membersihkan cache
RUN apt-get update
RUN apt-get install -y python3 python3-pip curl wget

# Menyalin seluruh direktori ke dalam image
COPY . /app

# Tidak menggunakan WORKDIR
RUN cd /app && pip3 install -r requirements.txt

# Menyimpan credential secara langsung
ENV DB_PASSWORD=supersecret123
ENV API_KEY=abc123xyz

EXPOSE 8080
CMD ["python3", "/app/app.py"]
